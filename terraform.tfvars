# terraform.tfvars - Configuration values
# Copy this to terraform.tfvars and update YOUR_IP before running terraform

aws_region   = "us-east-1"
instance_type = "t3.small"
instance_name = "edu-scraper"

# IMPORTANT: Replace with your IP address
# Get your IP from: https://whatismyipaddress.com
your_ip = "YOUR_PUBLIC_IP_HERE"

# Example:
# your_ip = "203.0.113.42"
